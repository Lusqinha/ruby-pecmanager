# Token do @BotFather
TELEGRAM_TOKEN=123456:ABC-DEF

# IDs do Telegram liberados (o bot recusa subir sem isso).
# Descubra o seu falando com @userinfobot.
ALLOWED_USER_IDS=111111111,222222222

# Backend do LLM: "ollama" (padrão, API nativa) ou "llamacpp" (OpenAI-compat)
LLM_BACKEND=ollama
LLAMA_URL=http://localhost:11434
LLAMA_MODEL=qwen2.5:1.5b
LLAMA_TIMEOUT=8

# Ajuste fino do Ollama em CPU fraca (celular). Padrões já vêm tunados:
# num_ctx 512, num_predict 80, num_thread 4, temperature 0.
# LLM_NUM_CTX=512
# LLM_NUM_PREDICT=80
# LLM_NUM_THREAD=4
# keep_alive=-1 mantém o modelo na RAM; use "30m" se a RAM for curta.
LLM_KEEP_ALIVE=-1

# Banco (padrão: data/pecman.db)
# DB_PATH=/var/lib/pecman/pecman.db
